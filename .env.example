# Copiar a .env.local y completar. .env.local NO se sube a Git.

# --- Frontend (públicas por diseño; la seguridad de datos depende de RLS) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# "anon key" o "publishable key" del proyecto Supabase
VITE_SUPABASE_ANON_KEY=
# Dominio de los emails internos que usa Supabase Auth (usuario "lorena" => lorena@<dominio>)
VITE_AUTH_EMAIL_DOMAIN=planner.uaa.com.ar

# --- Solo scripts locales de administración (NUNCA con prefijo VITE_) ---
SUPABASE_URL=https://<project-ref>.supabase.co
# "service_role key" o "secret key". Da acceso total: no compartir ni subir.
SUPABASE_SERVICE_ROLE_KEY=
